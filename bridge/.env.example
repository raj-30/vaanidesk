CHATWOOT_URL=http://localhost:3000
CHATWOOT_API_TOKEN=<redacted>
CHATWOOT_ACCOUNT_ID=1
SARVAM_WORKSPACE_KEY=paste_samvaad_workspace_key
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=1
SARVAM_CONNECTION_ID=
SARVAM_AGENT_NUMBER=+91XXXXXXXXXX
PUBLIC_BRIDGE_URL=https://your-tunnel.trycloudflare.com
# Inbound calls: create an API-channel inbox named "Phone Calls" in Chatwoot
# (Settings > Inboxes > Add Inbox > API) and put its numeric ID here.
# Leave empty to keep the inbound feature off.
INBOUND_INBOX_ID=
# AI summaries: Mercury 3 is the default provider (service ends 28 Dec 2026).
# Any OpenAI-compatible provider works - change AI_BASE_URL and AI_MODEL.
# Paste YOUR OWN key here, in this file only. Leave empty for no AI summaries.
AI_BASE_URL=https://api.inceptionlabs.ai/v1
AI_API_KEY=
AI_MODEL=mercury-3
